+//
+// Cadence GEM Ethernet controller integrated into RP1.
+//
+// RPI0001 is a project-specific ACPI ID used by the ESXi-Arm native
+// driver. Keep GEM as its only MMIO resource: this is the stable layout.
+//
+Device (ETH0) {
+  Name (_HID, "RPI0001")
+  Name (_UID, 0x0)
+
+  Method (_CRS, 0, Serialized) {
+    Name (RBUF, ResourceTemplate () {
+      RP1_QWORDMEMORY_BUF (00)
+      RP1_INTERRUPT_BUF (01)
+    })
+    RP1_QWORDMEMORY_SET (00, RP1_ETH_BASE, 0x10000)
+    RP1_INTERRUPT_SET (01)
+    Return (RBUF)
+  }
+
+  Name (_DSD, Package () {
+    ToUUID ("daffd814-6eba-4d8c-8a91-bc9bbf4aa301"),
+    Package () {
+      Package () { "compatible",        "raspberrypi,rp1-gem" },
+      Package () { "phy-mode",          "rgmii-id" },
+      Package () { "phy-address",       0x1 },
+      Package () { "phy-reset-gpio",    32 },
+      Package () { "phy-reset-active-low", 1 },
+      Package () { "phy-reset-duration-ms", 5 },
+      Package () { "dma-burst-length",  16 },
+      Package () { "cdns,aw2w-max-pipe", 8 },
+      Package () { "cdns,ar2r-max-pipe", 8 },
+      Package () { "cdns,use-aw2b-fill", 1 },
+      Package () { "pcie-posted-writes", 1 }
+    }
+  })
+}
+
+//
+// Separate read-only diagnostic device. ESXi reliably maps resource zero,
+// therefore GPIO control, RIO, and pads are exposed as one non-overlapping
+// 192 KiB window without changing ETH0's proven GEM resource.
