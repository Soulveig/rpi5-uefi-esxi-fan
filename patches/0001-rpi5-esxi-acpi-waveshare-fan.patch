diff --git a/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
new file mode 100644
index 0000000000000000000000000000000000000000..4da4c1f5d96c234a103feff1b0e928e0ef7fb403
--- /dev/null
+++ b/Platform/RaspberryPi/RPi5/Drivers/RpiPlatformDxe/FanControl.c
@@ -0,0 +1,192 @@
+/** @file
+ *  Raspberry Pi 5 RP1 PWM fan control.
+ *
+ *  SPDX-License-Identifier: BSD-2-Clause-Patent
+ */
+
+#include <Uefi.h>
+#include <Guid/EventGroup.h>
+#include <Guid/RpiPlatformFormSetGuid.h>
+#include <Library/DebugLib.h>
+#include <Library/UefiBootServicesTableLib.h>
+#include <Library/UefiRuntimeServicesTableLib.h>
+#include <Library/UefiLib.h>
+#include <Protocol/Rp1Bus.h>
+#include <Protocol/RpiFirmware.h>
+#include <RpiPlatformVarStoreData.h>
+
+#include "FanControl.h"
+
+STATIC FAN_MODE_VARSTORE_DATA   mFanMode  = { FAN_MODE_AUTOMATIC };
+STATIC FAN_SPEED_VARSTORE_DATA  mFanSpeed = { 100 };
+STATIC RP1_BUS_PROTOCOL         *mRp1Bus;
+STATIC RASPBERRY_PI_FIRMWARE_PROTOCOL *mFirmware;
+STATIC EFI_EVENT               mFanTimer;
+STATIC EFI_EVENT               mRp1NotifyEvent;
+STATIC EFI_EVENT               mFirmwareNotifyEvent;
+STATIC EFI_EVENT               mExitBootServicesEvent;
+STATIC VOID                    *mRp1Registration;
+STATIC VOID                    *mFirmwareRegistration;
+STATIC UINT8                   mAutoSpeed;
+
+STATIC
+VOID
+EFIAPI
+FanExitBootServices (
+  IN EFI_EVENT Event,
+  IN VOID      *Context
+  )
+{
+  // Stop all UEFI fan activity before the OS takes ownership of RP1/PCIe.
+  // The last programmed PWM value remains active in persistent mode.
+  if (mFanTimer != NULL) {
+    gBS->SetTimer (mFanTimer, TimerCancel, 0);
+    mFanTimer = NULL;
+  }
+  if ((mRp1Bus != NULL) && (mFanMode.Value != FAN_MODE_PERSISTENT)) {
+    mRp1Bus->RestoreFanState (mRp1Bus);
+  }
+}
+
+STATIC
+UINT8
+AutomaticSpeed (
+  IN UINT32 MilliCelsius
+  )
+{
+  // Raspberry Pi OS compatible curve, with 5 C hysteresis on downward steps.
+  if (MilliCelsius >= 75000) return 100;
+  if (MilliCelsius >= 67500) return 70;
+  if (MilliCelsius >= 60000) return 50;
+  if (MilliCelsius >= 50000) return 30;
+  if ((mAutoSpeed == 100) && (MilliCelsius >= 70000)) return 100;
+  if ((mAutoSpeed >= 70) && (MilliCelsius >= 62500)) return 70;
+  if ((mAutoSpeed >= 50) && (MilliCelsius >= 55000)) return 50;
+  if ((mAutoSpeed >= 30) && (MilliCelsius >= 45000)) return 30;
+  return 0;
+}
+
+STATIC
+VOID
+EFIAPI
+UpdateFan (
+  IN EFI_EVENT Event,
+  IN VOID      *Context
+  )
+{
+  EFI_STATUS Status;
+  UINT32     Temperature;
+  UINT8      Speed;
+  UINTN      Size;
+
+  Size = sizeof (mFanMode);
+  gRT->GetVariable (L"FanMode", &gRpiPlatformFormSetGuid, NULL, &Size, &mFanMode);
+  Size = sizeof (mFanSpeed);
+  gRT->GetVariable (L"FanSpeed", &gRpiPlatformFormSetGuid, NULL, &Size, &mFanSpeed);
+
+  if ((mFanMode.Value == FAN_MODE_MANUAL) ||
+      (mFanMode.Value == FAN_MODE_PERSISTENT)) {
+    Speed = MIN (mFanSpeed.Value, 100);
+  } else {
+    Status = mFirmware->GetTemperature (&Temperature);
+    if (EFI_ERROR (Status)) {
+      Speed = 100; // Fail safe if the temperature cannot be read.
+    } else {
+      Speed = AutomaticSpeed (Temperature);
+      mAutoSpeed = Speed;
+    }
+  }
+  mRp1Bus->SetFanSpeed (mRp1Bus, Speed);
+}
+
+VOID
+SetupFanVariables (
+  VOID
+  )
+{
+  EFI_STATUS Status;
+  UINTN      Size;
+  UINT32     Attributes;
+
+  Attributes = EFI_VARIABLE_NON_VOLATILE | EFI_VARIABLE_BOOTSERVICE_ACCESS | EFI_VARIABLE_RUNTIME_ACCESS;
+  Size = sizeof (mFanMode);
+  Status = gRT->GetVariable (L"FanMode", &gRpiPlatformFormSetGuid, NULL, &Size, &mFanMode);
+  if (EFI_ERROR (Status) || (mFanMode.Value > FAN_MODE_PERSISTENT)) {
+    mFanMode.Value = FAN_MODE_AUTOMATIC;
+    gRT->SetVariable (L"FanMode", &gRpiPlatformFormSetGuid, Attributes, sizeof (mFanMode), &mFanMode);
+  }
+  Size = sizeof (mFanSpeed);
+  Status = gRT->GetVariable (L"FanSpeed", &gRpiPlatformFormSetGuid, NULL, &Size, &mFanSpeed);
+  if (EFI_ERROR (Status) || (mFanSpeed.Value > 100)) {
+    mFanSpeed.Value = 100;
+    gRT->SetVariable (L"FanSpeed", &gRpiPlatformFormSetGuid, Attributes, sizeof (mFanSpeed), &mFanSpeed);
+  }
+}
+
+STATIC
+VOID
+TryStartFanControl (
+  VOID
+  )
+{
+  EFI_STATUS Status;
+
+  if (mFanTimer != NULL) {
+    return;
+  }
+
+  Status = gBS->LocateProtocol (&gRp1BusProtocolGuid, NULL, (VOID **)&mRp1Bus);
+  if (EFI_ERROR (Status)) return;
+  Status = gBS->LocateProtocol (&gRaspberryPiFirmwareProtocolGuid, NULL, (VOID **)&mFirmware);
+  if (EFI_ERROR (Status)) return;
+
+  UpdateFan (NULL, NULL);
+  Status = gBS->CreateEvent (EVT_TIMER | EVT_NOTIFY_SIGNAL, TPL_CALLBACK, UpdateFan, NULL, &mFanTimer);
+  if (!EFI_ERROR (Status)) {
+    gBS->SetTimer (mFanTimer, TimerPeriodic, 2 * 1000 * 1000 * 10);
+  }
+}
+
+STATIC
+VOID
+EFIAPI
+FanProtocolNotify (
+  IN EFI_EVENT Event,
+  IN VOID      *Context
+  )
+{
+  TryStartFanControl ();
+}
+
+VOID
+ApplyFanVariables (
+  VOID
+  )
+{
+  gBS->CreateEventEx (
+         EVT_NOTIFY_SIGNAL,
+         TPL_NOTIFY,
+         FanExitBootServices,
+         NULL,
+         &gEfiEventExitBootServicesGuid,
+         &mExitBootServicesEvent
+         );
+
+  // RpiPlatformDxe must load before PCI/RP1 initialization.  Wait for the
+  // consumer protocols instead of placing them in this driver's DEPEX.
+  mRp1NotifyEvent = EfiCreateProtocolNotifyEvent (
+                      &gRp1BusProtocolGuid,
+                      TPL_CALLBACK,
+                      FanProtocolNotify,
+                      NULL,
+                      &mRp1Registration
+                      );
+  mFirmwareNotifyEvent = EfiCreateProtocolNotifyEvent (
+                           &gRaspberryPiFirmwareProtocolGuid,
+                           TPL_CALLBACK,
+                           FanProtocolNotify,
+                           NULL,
+                           &mFirmwareRegistration
+                           );
+  TryStartFanControl ();
+}
