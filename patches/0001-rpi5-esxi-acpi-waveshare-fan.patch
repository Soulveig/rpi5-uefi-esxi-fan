+STATIC
+VOID
+EFIAPI
+Rp1BusEnableEthernetClocks (
+  IN RP1_BUS_DATA  *Rp1Data
+  )
+{
+  EFI_PHYSICAL_ADDRESS  ClockBase;
+  UINT32                Control;
+
+  ClockBase = Rp1Data->PeripheralBase + RP1_CLOCKS_MAIN_BASE;
+
+  //
+  // Match the assigned clocks in the upstream Raspberry Pi RP1 device
+  // tree: clk_eth = 125 MHz from pll_sys_sec and clk_eth_tsu = 50 MHz
+  // from xosc. Both selected parents are auxiliary-source index zero.
+  //
+  MmioWrite32 (ClockBase + RP1_CLK_ETH_DIV_INT, 1);
+  Control  = MmioRead32 (ClockBase + RP1_CLK_ETH_CTRL);
+  Control &= ~RP1_CLK_CTRL_AUXSRC_MASK;
+  Control |= RP1_CLK_CTRL_ENABLE;
+  MmioWrite32 (ClockBase + RP1_CLK_ETH_CTRL, Control);
+
+  MmioWrite32 (ClockBase + RP1_CLK_ETH_TSU_DIV_INT, 1);
+  Control  = MmioRead32 (ClockBase + RP1_CLK_ETH_TSU_CTRL);
+  Control &= ~RP1_CLK_CTRL_AUXSRC_MASK;
+  Control |= RP1_CLK_CTRL_ENABLE;
+  MmioWrite32 (ClockBase + RP1_CLK_ETH_TSU_CTRL, Control);
+
+  DEBUG ((
+    DEBUG_INFO,
+    "RP1: Ethernet clocks enabled (ETH_CTRL=%x, TSU_CTRL=%x)\n",
+    MmioRead32 (ClockBase + RP1_CLK_ETH_CTRL),
+    MmioRead32 (ClockBase + RP1_CLK_ETH_TSU_CTRL)
+    ));
+}
+
+STATIC
+VOID
+EFIAPI
+Rp1BusReleaseEthernetPhy (
+  IN RP1_BUS_DATA  *Rp1Data
+  )
+{
+  EFI_PHYSICAL_ADDRESS  GpioControl;
+  EFI_PHYSICAL_ADDRESS  PadControl;
+  EFI_PHYSICAL_ADDRESS  RioBase;
+  UINT32                Value;
+
+  //
+  // The on-board PHY reset is RP1 GPIO32, active low. GPIO32 is pin 4
+  // in bank 1. Configure it as a GPIO output, assert reset for 5 ms,
+  // then release it before the OS probes GEM/MDIO.
+  //
+  GpioControl = Rp1Data->PeripheralBase + RP1_IO_BANK1_BASE + (4 * 8) + 4;
+  PadControl  = Rp1Data->PeripheralBase + RP1_PADS_BANK1_BASE + 4 + (4 * 4);
+  RioBase     = Rp1Data->PeripheralBase + RP1_SYS_RIO1_BASE;
+
+  Value  = MmioRead32 (PadControl);
+  Value &= ~BIT7;
+  Value |= BIT6;
+  MmioWrite32 (PadControl, Value);
+
+  Value  = MmioRead32 (GpioControl);
+  Value &= ~(0x1FU | (0x3U << 12) | (0x3U << 14));
+  Value |= 5U;
+  MmioWrite32 (GpioControl, Value);
+
+  MmioWrite32 (RioBase + 0x3000, BIT4);
+  MmioWrite32 (RioBase + 0x2004, BIT4);
+  MicroSecondDelay (5000);
+  MmioWrite32 (RioBase + 0x2000, BIT4);
+  MicroSecondDelay (10000);
+
+  DEBUG ((DEBUG_INFO, "RP1: Ethernet PHY reset released on GPIO32\n"));
+}
