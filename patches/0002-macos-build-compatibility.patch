+    ATF_BUILD_SUBDIR="debug"
+else
+    ATF_BUILD_SUBDIR="release"
+fi
+ATF_BUILD_DIR="${PWD}/arm-trusted-firmware/build/rpi${MODEL}/${ATF_BUILD_SUBDIR}"
 
 export GCC_AARCH64_PREFIX="${CROSS_COMPILE}"
 export WORKSPACE=${PWD}
 export PACKAGES_PATH=${WORKSPACE}/edk2:${WORKSPACE}/edk2-platforms:${WORKSPACE}/edk2-non-osi
 
-make -C ${WORKSPACE}/edk2/BaseTools || exit
+# BaseTools were already built in this workspace; rebuilding on macOS invokes
+# an unavailable legacy `python` test runner.
+test -x ${WORKSPACE}/edk2/BaseTools/Source/C/bin/GenFv || exit
 
 source ${WORKSPACE}/edk2/edksetup.sh || exit
 
