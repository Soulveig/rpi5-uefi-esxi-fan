diff --git a/build.sh b/build.sh
index 22610c7299bbc990343aaf534bac3a17f5c7fda1..e7bda38ef3d4f2b8049077eec5efc7439c1915e2 100755
--- a/build.sh
+++ b/build.sh
@@ -27,8 +27,12 @@ print_usage() {
 #
 # Get options
 #
-OPTS=$(getopt -o '' -l 'model:,debug:,tfa-flags:,edk2-flags:,help' -- "${@}") || print_usage $?
-eval set -- "${OPTS}"
+if [[ $# -gt 0 ]]; then
+    OPTS=$(getopt -o '' -l 'model:,debug:,tfa-flags:,edk2-flags:,help' -- "${@}") || print_usage $?
+    eval set -- "${OPTS}"
+else
+    set -- --
+fi
 while true; do
     case "${1}" in
         --model) MODEL="${2}"; shift 2 ;;
@@ -90,13 +94,20 @@ else
     RELEASE_TYPE="RELEASE"
 fi
 
-ATF_BUILD_DIR="${PWD}/arm-trusted-firmware/build/rpi${MODEL}/${RELEASE_TYPE,,}"
